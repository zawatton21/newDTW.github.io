    (gr-set 1118 (gr-index-ref (gr-index-ref (gr-index-ref v76 (gr-get 1109)) 2) 1))
    (gr-set 1119 (gr-index-ref (gr-index-ref (gr-index-ref v76 (gr-get 1109)) 2) 2))
    (when (member (gr-get 1109) '(2 6 10))
      (when (equal (gr-index-ref (gr-get 493) (gr-get 1112)) 0)
        (let ((arr (gr-index-ref v71 (gr-get 1118))) (idx (gr-get 1119)))
          (when (and (vectorp arr) (integerp idx) (>= idx 0) (< idx (length arr)))
            (aset arr idx 0)))
        (let ((arr (gr-index-ref (gr-index-ref v76 (gr-get 1109)) 2)))
          (when (vectorp arr)
            (aset arr 1 0)
            (aset arr 2 0)))))
    (when (member (gr-get 1109) '(3 4 7 8 11 12))
      (when (and (equal (gr-index-ref (gr-get 493) (gr-get 1112)) 0)
                 (equal (gr-index-ref (gr-get 493) (gr-get 1113)) 0))
        (let ((arr (gr-index-ref v71 (gr-get 1118))) (idx (gr-get 1119)))
          (when (and (vectorp arr) (integerp idx) (>= idx 0) (< idx (length arr)))
            (aset arr idx 0)))
        (let ((arr (gr-index-ref (gr-index-ref v76 (gr-get 1109)) 2)))
          (when (vectorp arr)
            (aset arr 1 0)
            (aset arr 2 0)))))
    (when (and (not (equal (gr-get 1114) 0)) (not (equal (gr-get 1115) 0)))
      (unless (and (equal (gr-get 1110) (gr-get 95))
                   (not (equal (gr-get 1005) 1)))
        (when (or (equal (gr-get 1116) 0) (equal (gr-get 1117) 0))
          (gr-set 1116 (gr-index-ref (gr-index-ref (gr-index-ref v76 (gr-get 1111)) 2) 1))
          (gr-set 1117 (gr-index-ref (gr-index-ref (gr-index-ref v76 (gr-get 1111)) 2) 2)))
        (unless (or (equal (gr-get 1116) 0) (equal (gr-get 1117) 0))
          (gr-set 1120 (gr-get 1114))
          (gr-set 1121 (gr-get 1115))
          (gr-set 1122 (- (gr-num (gr-get 1116)) (gr-num (gr-get 1114)) 1))
          (gr-set 1123 (1+ (gr-random (gr-get 1122))))
          (let ((cnt1 0))
            (while (< cnt1 (gr-num (gr-get 1123)))
              (let ((arr (gr-index-ref v71 (gr-get 1120))) (idx (gr-get 1121)))
                (when (and (vectorp arr) (integerp idx) (>= idx 0) (< idx (length arr)))
                  (aset arr idx 14)))
              (gr-set 1120 (1+ (gr-num (gr-get 1120))))
              (setq cnt1 (1+ cnt1))))
          (cond
           ((equal (gr-get 1115) (gr-get 1117)) (gr-set 1124 0))
           ((> (gr-num (gr-get 1115)) (gr-num (gr-get 1117))) (gr-set 1124 1))
           (t (gr-set 1124 2)))
          (let ((cnt1 0))
            (while (< cnt1 10)
              (let ((arr (gr-index-ref v71 (gr-get 1120))) (idx (gr-get 1121)))
                (when (and (vectorp arr) (integerp idx) (>= idx 0) (< idx (length arr)))
                  (aset arr idx 14)))
              (when (equal (gr-get 1121) (gr-get 1117))
                (setq cnt1 10))
              (when (equal (gr-get 1124) 1)
                (gr-set 1121 (max 0 (1- (gr-num (gr-get 1121))))))
              (when (equal (gr-get 1124) 2)
                (gr-set 1121 (1+ (gr-num (gr-get 1121)))))
              (setq cnt1 (1+ cnt1))))
          (let ((cnt1 0))
            (while (< cnt1 30)
              (let ((arr (gr-index-ref v71 (gr-get 1120))) (idx (gr-get 1121)))
                (when (and (vectorp arr) (integerp idx) (>= idx 0) (< idx (length arr)))
                  (aset arr idx 14)))
              (when (equal (gr-get 1120) (gr-get 1116))
                (setq cnt1 30))
              (gr-set 1120 (1+ (gr-num (gr-get 1120))))
              (setq cnt1 (1+ cnt1)))))))))

