(defun gr-worldgen-install-local-natives ()
  "Install local natives needed by the fixed worldgen path."
  (setq gr-worldgen-saved-local-natives nil)
  (dolist (name-fn '(("func250" . gr-worldgen-native-func250)
                     ("func251" . gr-worldgen-native-func251)
                     ("func252" . gr-worldgen-native-func252)
                     ("func536" . gr-worldgen-native-func536)
                     ("func628" . gr-worldgen-native-func628)
                     ("func720" . gr-worldgen-native-func720)
                     ("func231" . gr-worldgen-native-func231)))
    (push (cons (car name-fn) (gethash (car name-fn) gr-native-funcs))
          gr-worldgen-saved-local-natives)
    (gr-defnative (car name-fn) (symbol-function (cdr name-fn)))))

(defun gr-worldgen-restore-local-natives ()
  "Restore any natives replaced for worldgen verification."
  (dolist (entry gr-worldgen-saved-local-natives)
    (if (cdr entry)
        (gr-defnative (car entry) (cdr entry))
      (when gr-native-funcs
        (remhash (car entry) gr-native-funcs))))
  (setq gr-worldgen-saved-local-natives nil))

(defun gr-worldgen-count-map ()
  "Return (FLOOR WALLS) from var_71 over the active map rectangle."
  (let ((floor 0)
        (walls 0)
        (x 0)
        (y 0)
        (limit-x (gr-num (or (gr-get 31) 0)))
        (limit-y (gr-num (or (gr-get 32) 0)))
        (tiles (gr-get 71))
        (cell nil))
    (while (< y limit-y)
      (setq x 0)
      (while (< x limit-x)
        (setq cell (gr-index-ref (gr-index-ref tiles x) y))
        (when (and (numberp cell) (>= cell 1) (<= cell 12))
          (setq floor (1+ floor)))
        (when (equal cell 13)
          (setq walls (1+ walls)))
        (setq x (1+ x)))
      (setq y (1+ y)))
    (list floor walls)))

(defun gr-worldgen-count-records (slot)
  "Count nonzero Var0 entries in SLOT."
  (let ((rows (gr-get slot))
        (count 0)
        (i 0)
        (row nil))
    (when (vectorp rows)
      (while (< i (length rows))
        (setq row (aref rows i))
        (when (and row (not (equal (gr-prop-ref row "Var0") 0)) (not (equal (gr-prop-ref row "Var0") nil)))
          (setq count (1+ count)))
        (setq i (1+ i))))
    count))

