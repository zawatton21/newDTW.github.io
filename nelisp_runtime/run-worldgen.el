;;; run-worldgen.el --- self-generated dungeon worldgen verification -*- coding: utf-8; -*-

(defconst gr-worldgen-build-dir
  (expand-file-name "../build" (file-name-directory (or load-file-name buffer-file-name))))

(defvar gr-worldgen-saved-func009 nil
  "Saved native func009 while world generation runs without entering the loop.")
(defvar gr-worldgen-saved-local-natives nil
  "Alist of native implementations overridden for worldgen verification.")
(defvar gr-worldgen-use-existing-state nil
  "When non-nil, reuse the current initialized state instead of seeding one.")
(defvar gr-worldgen-autorun t
  "When non-nil, execute the verification when this file is loaded.")

(defun gr-worldgen-with-loop-disabled (thunk)
  "Run THUNK with func009 temporarily replaced by a no-op."
  (setq gr-worldgen-saved-func009 (gethash "func009" gr-native-funcs))
  (unwind-protect
      (progn
        ;; func006 -> func007 -> func008 now reaches func009; worldgen only
        ;; needs the generated state, not the interactive loop.
        (gr-defnative "func009" (lambda (&rest _args) nil))
        (funcall thunk))
    (when gr-worldgen-saved-func009
      (gr-defnative "func009" gr-worldgen-saved-func009))
    (setq gr-worldgen-saved-func009 nil)))

(defun gr-worldgen-native-func250 (&rest _args)
  "Local corridor helper from func250."
  (let ((v76 (gr-get 76))
        (v71 (gr-get 71)))
    (push 250 gr-trace)
    (gr-set 1114 (gr-index-ref (gr-index-ref (gr-index-ref v76 (gr-get 1109)) 3) 1))
    (gr-set 1115 (gr-index-ref (gr-index-ref (gr-index-ref v76 (gr-get 1109)) 3) 2))
    (gr-set 1116 (gr-index-ref (gr-index-ref (gr-index-ref v76 (gr-get 1110)) 2) 1))
