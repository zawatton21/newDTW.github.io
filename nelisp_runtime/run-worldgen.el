(defun gr-worldgen-native-func252 (&rest _args)
  "Local cleanup helper from func252."
  (let ((v71 (gr-get 71))
        (y 1)
        (x 1))
    (push 252 gr-trace)
    (while (< y (gr-num (gr-get 32)))
      (setq x 1)
      (while (< x (gr-num (gr-get 31)))
        (when (equal (gr-index-ref (gr-index-ref v71 x) y) 14)
          (let ((left (max 0 (1- x)))
                (right (min (gr-num (gr-get 31)) (1+ x)))
                (up (max 0 (1- y)))
                (down (min (gr-num (gr-get 32)) (1+ y))))
            (when (and (not (equal (gr-index-ref (gr-index-ref v71 left) y) 14))
                       (not (equal (gr-index-ref (gr-index-ref v71 right) y) 14))
                       (not (equal (gr-index-ref (gr-index-ref v71 x) up) 14))
                       (not (equal (gr-index-ref (gr-index-ref v71 x) down) 14)))
              (let ((arr (gr-index-ref v71 x)))
                (when (and (vectorp arr) (>= y 0) (< y (length arr)))
                  (aset arr y 0))))))
        (setq x (1+ x)))
      (setq y (1+ y)))))

