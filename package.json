{
  "name": "newdtw",
  "version": "1.0.0",
  "description": "Rebuild Diavolo The Wanderer",
  "main": "public/main/main.js",
  "scripts": {
    "build": "tsc && webpack",
    "build:browser": "webpack --config webpack.browser.cjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "watch": "webpack -w",
    "lint": "eslint -c .eslintrc --ext .ts ./src",
    "start": "npm run build && electron public/main/main.js",
    "play:nelisp": "npm run build && node tools/start_nelisp.js",
    "dev": "node tools/dev.js",
    "test:smoke": "electron tools/test_scenarios.js smoke",
    "test:menu": "electron tools/test_scenarios.js menu",
    "test:lang": "electron tools/test_scenarios.js lang",
    "test:i18n": "electron tools/test_scenarios.js i18n",
    "test:main": "electron tools/test_scenarios.js main",
    "test:settings": "electron tools/test_scenarios.js settings",
    "test:library": "electron tools/test_scenarios.js library",
    "nelisp:registry": "node tools/generate_nelisp_game_registry.js",
    "nelisp:maps": "node tools/generate_nelisp_map_state_diff.js",
    "nelisp:selections": "node tools/generate_nelisp_selection_state_diff.js --name func0948 --name func0950 --name func0952",
    "nelisp:conditional-measure": "node tools/measure_nelisp_conditional_runtime.js",
    "nelisp:conditional-runtime": "node tools/measure_nelisp_conditional_runtime.js && node tools/generate_nelisp_conditional_runtime.js --names-file build/nelisp-conditional-runtime-names.txt",
    "nelisp:candidates": "node tools/extract_nelisp_bridge_candidates.js",
    "test:nelisp-runner": "node tools/nelisp_state_diff_runner_smoke.js",
    "test:nelisp-electron": "electron tools/test_scenarios.js nelisp",
    "test:all": "electron tools/test_scenarios.js all",
    "docs:vars": "node tools/extract_var_dict.js",
    "dist": "electron-builder"
  },
  "repository": "https://github.com/zawatton/newDTW.github.io.git",
  "keywords": [
    "Electron",
    "quick",
    "start",
    "tutorial",
    "demo",
    "typescript"
  ],
  "type": "commonjs",
  "author": "Zawa-Ton",
  "license": "CC0-1.0",
  "devDependencies": {
    "@babel/core": "^7.22.10",
    "@babel/preset-env": "^7.22.10",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^18.11.8",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "babel-loader": "^9.1.3",
    "dependency-cruiser": "^16.8.0",
    "electron": "^22.0.0-alpha.6",
    "electron-builder": "^24.0.0",
    "electron-store": "^8.1.0",
    "eslint": "^7.32.0",
    "puppeteer": "^24.40.0",
    "typescript": "^4.8.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "electron-log": "^4.4.8",
    "msgpack-lite": "^0.1.26",
    "ts-loader": "^9.4.4",
    "ts2c": "^2.2.9",
    "yargs": "^7.1.2",
    "yargs-parser": "^5.0.0"
  },
  "build": {
    "appId": "com.electron.yourapp",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "public/index.html",
      "public/main/*",
      "public/bundle/*",
      "public/lib/*",
      "assets/**/*",
      "package.json",
      "package-lock.json"
    ],
    "mac": {
      "icon": "assets/icon/mac/icon_mac.icns",
      "target": {
        "target": "default",
        "arch": [
          "universal"
        ]
      }
    },
    "win": {
      "icon": "assets/icon/win/icon_win.ico",
      "target": {
        "target": "nsis",
        "arch": [
          "ia32",
          "x64",
          "arm64"
        ]
      }
    },
    "linux": {
      "icon": " assets/icon/linux/DTW.png",
      "target": {
        "target": "AppImage",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    },
    "deb": {},
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
